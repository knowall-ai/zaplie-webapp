# Server-side (Node / App Service) settings for backend/server.js.
# These are read at runtime by the server, not compiled into the React bundle.
# On Azure, set them as App Service "Application settings"; locally, pass them
# on the command line, e.g. `AAD_CLIENT_ID=... APPROVED_TENANT_IDS=... npm start`.

# Entra app registration client ID, used to verify users' ID tokens.
# Same value as REACT_APP_AAD_CLIENT_ID.
AAD_CLIENT_ID=REPLACE_WITH_AAD_CLIENT_ID

# Organisations approved to use Zaplie: comma-separated Entra tenant GUIDs.
# The KnowAll tenant (f36f6414-cb7d-4545-9cf2-7574f7b5c584) is always approved
# and doesn't need listing. To approve an organisation, add its tenant ID here.
APPROVED_TENANT_IDS=
