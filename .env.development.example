# ==========================================================================
# .env.development.example — template for local development configuration
# --------------------------------------------------------------------------
# Copy this file to `.env.development` (gitignored, MUST NEVER be committed)
# and fill each placeholder with a DEV-ONLY value.
#
# ⚠️  SECURITY WARNING — REACT_APP_* VALUES ARE PUBLIC ⚠️
# Every REACT_APP_* variable is compiled into the browser JS bundle at build
# time and shipped to every user's browser. They are NOT secret. Treat every
# value you put here as public. Therefore:
#   • Use ONLY throwaway, dev-only credentials scoped to a test LNbits
#     instance. NEVER reuse production or shared credentials here.
#   • NEVER put a real/production LNbits admin key, password, or any
#     privileged credential in a REACT_APP_* variable — doing so publishes it
#     to anyone who opens the app.
# Long-term fix: privileged LNbits operations (admin key usage, wallet
# management) belong behind a backend proxy that holds the secret
# server-side; the browser should only ever talk to that proxy, never to
# LNbits directly with an admin key.
# ==========================================================================

# LNbits instance the web app talks to
REACT_APP_LNBITS_NODE_URL=https://your-lnbits-instance.example.com

# LNbits account identity — dev-only credentials only (see warning above).
# For anything privileged, prefer a backend proxy over embedding a real key.
REACT_APP_LNBITS_USERNAME=REPLACE_WITH_LNBITS_USERNAME
REACT_APP_LNBITS_PASSWORD=REPLACE_WITH_LNBITS_PASSWORD
REACT_APP_LNBITS_ADMINKEY=REPLACE_WITH_LNBITS_ADMIN_KEY

# LNbits store configuration
REACT_APP_LNBITS_STORE_ID=REPLACE_WITH_LNBITS_STORE_ID
REACT_APP_LNBITS_STORE_OWNER_EMAIL=owner@example.com

# Azure AD / Entra ID app registration
REACT_APP_TENANT_ID=REPLACE_WITH_TENANT_ID
REACT_APP_AAD_CLIENT_ID=REPLACE_WITH_AAD_CLIENT_ID

# Display label for points/sats (admin-configurable)
REACT_APP_LNBITS_POINTS_LABEL="Sats"
