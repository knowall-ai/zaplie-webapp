REACT_APP_LNBITS_ADMINKEY=
REACT_APP_LNBITS_STORE_ID=
REACT_APP_LNBITS_STORE_OWNER_EMAIL=
REACT_APP_TENANT_ID=
REACT_APP_AAD_CLIENT_ID=
REACT_APP_LNBITS_POINTS_LABEL=Sats
